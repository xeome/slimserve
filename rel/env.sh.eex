#!/bin/sh
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"

# Anyone who pulls the image can read its built-in cookie, so a node with distribution on needs its own.
# The `if` form matters: the release script runs `set -e`, and a sourced file ending on status 1 kills it.
case "$RELEASE_DISTRIBUTION" in
  name | sname)
    if [ -z "${RELEASE_COOKIE:-}" ]; then
      echo "set RELEASE_COOKIE: the image's built-in cookie is public" >&2
      exit 1
    fi
    ;;
esac
