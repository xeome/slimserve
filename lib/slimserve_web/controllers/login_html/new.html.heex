<Layouts.app flash={@flash} login_page>
  <.form for={@form} action={~p"/.app/login"} id="login-form" class="card login">
    <h1>Log in</h1>
    <.input field={@form[:next]} type="hidden" />
    <.input field={@form[:username]} label="Username" autocomplete="username" required />
    <.input
      field={@form[:password]}
      type="password"
      label="Password"
      autocomplete="current-password"
      required
    />
    <p :if={@error} class="field-error">{@error}</p>
    <button type="submit" class="btn primary">Log in</button>
  </.form>
</Layouts.app>
